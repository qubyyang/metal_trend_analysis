# 行情数据源配置（多源自动降级）
api:
  stooq:
    base_url: "https://stooq.com/q/d/l/"
    timeout: 20
    retry: 3
    retry_delay: 2
    default_kline_count: 200

# 多数据源与缓存配置
market_data:
  # 数据源优先级，主源失败时自动降级到下一个
  # sina  : 新浪财经，国内直连稳定，推荐作为主源
  # sina_forex : 新浪外汇接口，仅覆盖美元指数（DXY），与 sina 品种不重叠
  # stooq : 已启用 JS 反爬挑战，部分网络环境下不可用
  # yahoo : 对部分地区返回 403，仅作末位兜底
  providers: ["sina", "sina_forex", "stooq", "yahoo"]
  cache_enabled: true
  cache_ttl: 3600          # 缓存有效期（秒）
  cache_dir: "data/cache"
  allow_stale_cache: true  # 所有数据源失效时，是否允许使用过期缓存兜底
  yahoo:
    base_url: "https://query1.finance.yahoo.com/v8/finance/chart/"
    range: "2y"

# 信号回测配置
backtest:
  signal_store: "data/signals/signals.jsonl"
  horizon_days: 5      # 信号持有期（自然日），到期后评估方向是否正确
  threshold_pct: 0.5   # 判定有效方向变动的最小幅度，低于此值计为“平”

# 跨品种联动分析（可选增强，任一辅助品种失败只跳过该项，不影响主流程）
cross_asset:
  enabled: true
  # 除金银外额外拉取的参照品种：
  #   XPTUSD 铂金 / HGUSD 铜 / CLUSD 原油 / DXY 美元指数
  auxiliary_symbols: ["XPTUSD", "HGUSD", "CLUSD", "DXY"]
  lookback_days: 400        # 拉取的历史日线根数
  correlation_window: 60    # 滚动相关性窗口（交易日）
  percentile_window: 250    # 比价历史分位参考窗口
  divergence_sigma: 2.0     # 相关性偏离历史均值多少个标准差算作背离

# LLM API 配置
llm:
  provider: "openai"  # 可选: openai, deepseek, qwen, other
  api_key: "${LLM_API_KEY}"
  base_url: "${LLM_BASE_URL}"  # 可选，用于第三方 API（如 DeepSeek）
  model: "${LLM_MODEL_NAME}"  # 如: gpt-4o, deepseek-chat
  temperature: 0.7
  max_tokens: 2000
  timeout: 60

# 分析品种配置
instruments:
  gold:
    symbol: "XAUUSD"
    name: "国际现货黄金"
    region: "GB"
    stooq_symbol: "xauusd"
    enabled: true
  silver:
    symbol: "XAGUSD"
    name: "国际现货白银"
    region: "GB"
    stooq_symbol: "xagusd"
    enabled: true

# 技术指标参数
indicators:
  ma:
    periods: [5, 10, 20, 60]
  macd:
    fast: 12
    slow: 26
    signal: 9
  rsi:
    period: 14
    overbought: 70
    oversold: 30
  bollinger:
    period: 20
    std_dev: 2

# 支撑阻力位识别
support_resistance:
  lookback: 100
  swing_points: 3
  proximity: 0.01  # 1% 容差

# 新闻配置
news:
  enabled: true  # 启用新闻抓取
  max_articles: 10  # 每个源最多抓取的文章数
  cache_duration: 300  # 缓存时长（秒，5分钟）
  fetch:
    timeout: 15
    delay: 2  # 不同源之间的请求延迟（秒）
    max_retries: 3
  sources:
    # 英文RSS新闻源 (已验证可用)
    - name: "Bloomberg Markets"
      type: "rss"
      url: "https://feeds.bloomberg.com/markets/news.rss"
      enabled: true
    - name: "CNBC Market News"
      type: "rss"
      url: "https://www.cnbc.com/id/10000664/device/rss/rss.html"
      enabled: true
    # WSJ 市场版：贵金属结算价报道覆盖度高（如 "Comex Gold, Silver Settle Lower"）
    - name: "WSJ Markets"
      type: "rss"
      url: "https://feeds.a.dj.com/rss/RSSMarketsMain.xml"
      enabled: true

    # 中文RSS新闻源
    # 注：凤凰网财经 RSS (finance.ifeng.com/rss/index.xml) 已于 2026 年下线返回 404；
    #     新浪财经滚动 RSS 虽返回 200，但条目为空，均不可用。
    #     东方财富合作伙伴源实测稳定返回近百条中文财经资讯。
    - name: "东方财富"
      type: "rss"
      url: "https://rss.eastmoney.com/rss_partener.xml"
      enabled: true

    # 其他中文源（使用 HTML 解析 + Jina AI 文本代理，确保可拉取）
    - name: "华尔街见闻"
      type: "html"
      url: "https://r.jina.ai/http://wallstreetcn.com/"
      parser: "markdown_links"
      link_contains:
        - "wallstreetcn.com/articles"
        - "wallstreetcn.com/livenews"
      enabled: true
    - name: "财联社电报"
      type: "html"
      url: "https://r.jina.ai/http://www.cls.cn/telegraph"
      parser: "cls_telegraph"
      enabled: true
    - name: "澎湃新闻"
      type: "html"
      url: "https://r.jina.ai/http://www.thepaper.cn/list_25434"
      parser: "markdown_links"
      link_contains:
        - "thepaper.cn/newsDetail"
      enabled: true

    # 注意：以下源已验证不可用或需要特殊处理，已暂时禁用
    # - Reuters: DNS解析失败
    # - Financial Times: 404错误
    # - MarketWatch: 403禁止访问
    # - 新浪财经: 404错误
    # - 腾讯财经: 301重定向
    # - 网易财经: 404错误
    # - 和讯网: 需要JavaScript处理
    # - 东方财富网: 无RSS内容
    # - 澎湃新闻: 302重定向

# 通知推送配置
# 通知是否启用仅取决于 .env 中是否配置了对应的 webhook URL / 配置信息
# 不需要在这里配置 enabled 开关
notification:
  channels:
    feishu:
      webhook_url: "${FEISHU_WEBHOOK_URL}"  # 从环境变量读取，留空则不推送
      timeout: 30
    dingtalk:
      webhook_url: "${DINGTALK_WEBHOOK_URL}"  # 从环境变量读取，留空则不推送
      timeout: 30
    slack:
      webhook_url: "${SLACK_WEBHOOK_URL}"  # 从环境变量读取，留空则不推送
      timeout: 30
    telegram:
      bot_token: "${TELEGRAM_BOT_TOKEN}"  # 从环境变量读取，留空则不推送
      chat_id: "${TELEGRAM_CHAT_ID}"  # 从环境变量读取，留空则不推送
      timeout: 30
    email:
      from: "${EMAIL_FROM}"  # 从环境变量读取，留空则不推送
      password: "${EMAIL_PASSWORD}"  # 从环境变量读取
      to: "${EMAIL_TO}"  # 从环境变量读取，多个收件人用逗号分隔
      smtp_server: "${EMAIL_SMTP_SERVER}"  # 可选，留空则自动检测
      smtp_port: "${EMAIL_SMTP_PORT}"  # 可选，留空则自动检测
      timeout: 30

# 报告配置
reports:
  output_dir: "output/reports"
  format: "markdown"  # markdown, html, json
  include_charts: true
  chart_dir: "output/charts"
  chart_dpi: 130
  chart_bars: 120     # 图表展示最近多少根 K 线

# 日志配置
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  file: "output/logs/app.log"
  max_size: 10485760  # 10MB
  backup_count: 5
